{
  "expo": {
    "name": "Drop AI",
    "slug": "drop-ai",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.dailydrop.dropai",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "Allow Drop AI to access your microphone for voice ordering and speech input."
      }
    },
    "android": {
      "package": "com.dailydrop.dropai",
      "softwareKeyboardLayoutMode": "resize",
      "usesCleartextTraffic": true,
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.INTERNET",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "4ee2b67e-4700-4a18-beee-cad8ad4a5369"
      }
    },
    "plugins": [
      "expo-status-bar",
      "expo-font",
      [
        "expo-audio",
        {
          "microphonePermission": "Allow Drop AI to access your microphone for voice ordering and speech input."
        }
      ]
    ],
    "owner": "rohit51"
  }
}
