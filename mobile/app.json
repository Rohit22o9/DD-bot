{
  "expo": {
    "name": "Drop AI",
    "slug": "drop-ai",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.dailydrop.dropai",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "Allow Drop AI to access your microphone for voice ordering and speech input."
      }
    },
    "android": {
      "package": "com.dailydrop.dropai",
      "softwareKeyboardLayoutMode": "resize",
      "usesCleartextTraffic": true,
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.INTERNET",
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "a3343b25-b15f-455d-a0ff-511c248ad3c1"
      }
    },
    "plugins": [
      "expo-status-bar",
      "expo-font",
      [
        "expo-audio",
        {
          "microphonePermission": "Allow Drop AI to access your microphone for voice ordering and speech input."
        }
      ]
    ]
  }
}
